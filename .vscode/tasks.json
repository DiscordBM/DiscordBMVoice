{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Swift: Build (Debug)",
      "type": "shell",
      "command": "swift build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$swiftc"
    },
    {
      "label": "Swift: Build (Release)",
      "type": "shell",
      "command": "swift build -c release",
      "group": "build",
      "problemMatcher": "$swiftc"
    },
    {
      "label": "Swift: Test",
      "type": "shell",
      "command": "swift test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$swiftc"
    },
    {
      "label": "Swift: Format",
      "type": "shell",
      "command": "swift-format format -i --recursive Sources Tests",
      "problemMatcher": []
    },
    {
      "label": "Swift: Lint",
      "type": "shell",
      "command": "swift-format lint --recursive Sources Tests",
      "problemMatcher": []
    }
  ]
}
