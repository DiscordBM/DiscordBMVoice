{
  "swift.sourcekit-lsp.backgroundIndexing": true,
  "swift.sourcekit-lsp.inlayHints.enabled": true,
  "swift.sourcekit-lsp.inlayHints.parameterNames": true,
  "swift.sourcekit-lsp.inlayHints.typeInference": true,
  "swift.format.provider": "swift-format",
  "editor.formatOnSave": true,
  "[swift]": {
    "editor.defaultFormatter": "swiftlang.swift-vscode",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    }
  },
  "files.associations": {
    "Package.resolved": "json"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true
  }
}
